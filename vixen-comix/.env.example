# Copy this file to .env and fill in the values. .env is ignored by git.
# Only values that are safe to ship in browser code belong here.
# Vite reads these when you run `npm run dev` or `npm run build`,
# so rebuild after you change them.

# Supabase project URL (Project Settings > API > Project URL).
# Used for reader accounts (see README). Leave empty to run
# the site without sign-in.
VITE_SUPABASE_URL=

# Supabase publishable key (sb_publishable_..., or the older "anon" key). Safe for the browser.
# Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# Full URL that receives the Contact form POST (JSON: name, email, message).
# Leave empty and the Contact page shows a "not connected yet" notice.
VITE_CONTACT_API_URL=

# Development only: set to true to use a fake in-browser Supabase stand-in
# with data in localStorage. Ignored by production builds.
VITE_USE_MOCK_SUPABASE=
